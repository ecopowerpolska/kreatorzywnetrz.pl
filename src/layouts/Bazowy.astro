---
// Bazowy.astro — jedyny layout strony: head (canonical, OG, Twitter, JSON-LD), nagłówek, stopka.
// Bez cookies, bez analityki, bez skryptów zewnętrznych, bez <ClientRouter /> (strona prawie statyczna).
import '../styles/motyw.css';
import { getImage } from 'astro:assets';
import Naglowek from '../components/Naglowek.astro';
import Stopka from '../components/Stopka.astro';
import { t } from '../lib/tekst';
import { zdjecie, ZDJECIE_GLOWNE } from '../lib/zdjecia';

interface Props {
  tytul: string;
  opis: string;
  /** `article` dla wpisu, domyślnie `website`. */
  typOg?: 'website' | 'article';
  /** Bezwzględny adres obrazu do udostępnień; domyślnie kadr 1200×630 ze zdjęcia głównego. */
  obrazOg?: string;
  obrazOgAlt?: string;
  /** Obiekty JSON-LD (schema.org) do wstawienia w <head>. */
  schemat?: Record<string, unknown>[];
  bezIndeksu?: boolean;
  /** Strona błędu 404: adres nie istnieje, więc nie ma canonical (og:url zostaje). */
  bezKanonicznego?: boolean;
  /** Adres pozycji menu do podświetlenia, gdy strona leży poza jej adresem (wpis → jego dział). */
  podswietl?: string;
}

const { tytul, opis, typOg = 'website', obrazOg, obrazOgAlt, schemat = [], bezIndeksu = false, bezKanonicznego = false, podswietl } = Astro.props;
const nazwa = t('marka.nazwa');
const kanoniczny = new URL(Astro.url.pathname, import.meta.env.SITE);

let og = obrazOg;
let ogAlt = obrazOgAlt;
if (!og) {
  const kadr = await getImage({ src: zdjecie(ZDJECIE_GLOWNE), width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 });
  og = new URL(kadr.src, import.meta.env.SITE).href;
  ogAlt = nazwa;
}
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tytul}</title>
    <meta name="description" content={opis} />
    <meta name="google-site-verification" content="BtiwSnpeg79W3XRknGVla95xI-LvrXFd87SCxVMyYvI" />
    <meta name="robots" content={bezIndeksu ? 'noindex' : 'max-image-preview:large'} />
    {!bezKanonicznego && <link rel="canonical" href={kanoniczny} />}

    <meta property="og:type" content={typOg} />
    <meta property="og:site_name" content={nazwa} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={tytul} />
    <meta property="og:description" content={opis} />
    <meta property="og:url" content={kanoniczny} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tytul} />
    <meta name="twitter:description" content={opis} />
    <meta name="twitter:image" content={og} />

    <meta name="theme-color" content="#0f3e47" />
    <link rel="icon" href="/favicon.svg?v=20261103" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png?v=20261103" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261103" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${nazwa}: wpisy`} href="/rss.xml" />

    {schemat.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip" href="#tresc">{t('interfejs.przejdzDoTresci')}</a>
    <Naglowek {podswietl} />
    <main id="tresc" tabindex="-1">
      <slot />
    </main>
    <Stopka />
  </body>
</html>
