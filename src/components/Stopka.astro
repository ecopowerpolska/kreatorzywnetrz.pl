---
// Stopka: nazwa i opis magazynu, dział Materiały, O nas, polityka prywatności, prawa. Bez linków dla robotów
// (RSS, llms.txt, sitemapa): kanał RSS ogłasza <link rel="alternate"> w Bazowy.astro.
// Zero odnośników do firm (reguła strony linkującej).
import { t, wstaw } from '../lib/tekst';
import { adresDzialu } from '../lib/dzialy';

// Rok BUDOWY (czas Warszawy). Przebudowa w Actions odświeża go po 1 stycznia.
const rok = new Intl.DateTimeFormat('pl-PL', { year: 'numeric', timeZone: 'Europe/Warsaw' }).format(new Date());
const odnosniki = [
  { etykieta: t('stopka.materialy'), href: adresDzialu('materialy') },
  { etykieta: t('stopka.oNas'), href: '/o-nas/' },
  { etykieta: t('stopka.polityka'), href: '/polityka-prywatnosci/' },
];
---

<footer class="stopka">
  <div class="kontener stopka__pas">
    <div>
      <p class="stopka__nazwa">{t('marka.nazwa')}</p>
      <p class="stopka__opis">{t('marka.opisKrotki')}</p>
    </div>
    <ul>
      {odnosniki.map((o) => <li><a href={o.href}>{o.etykieta}</a></li>)}
    </ul>
    <p class="stopka__prawa">{wstaw(t('stopka.prawa'), { rok })}</p>
  </div>
</footer>
