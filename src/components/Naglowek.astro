---
// Naglowek.astro — przyklejony pas w jednej linii. Progi zapytaniem kontenera (motyw.css), nie oknem.
// Menu z teksty.json `menu` [{etykieta, href}] (6 pozycji). Podkreślnik pozycji: CSS ::after w motyw.css.
// Telefon: przełącznik menu (aria-expanded, Esc, klik w pozycję, inert na main i stopce).
import { t, obiekty, pole } from '../lib/tekst';

interface Props {
  /** Adres działu do podświetlenia, gdy strona nie leży pod jego adresem (wpis /blog/<slug>/ → /<dzial>/). */
  podswietl?: string;
}
const { podswietl } = Astro.props;
const sciezka = Astro.url.pathname;
const pozycje = obiekty('menu').map((p, i) => {
  const etykieta = pole(p, 'etykieta', `menu.${i}`);
  const href = pole(p, 'href', `menu.${i}`);
  // Strona z `podswietl` (wpis) podświetla tylko swój dział, nie także „Blog”, pod którego adresem leży.
  return { etykieta, href, biezaca: podswietl ? href === podswietl : sciezka.startsWith(href) };
});
---

<header class="naglowek" id="naglowek">
  <div class="naglowek__pas kontener">
    <a class="marka" href="/" aria-current={sciezka === '/' ? 'page' : undefined}>
      <svg class="marka__znak" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <rect width="48" height="48" rx="12" fill="#7a1f3d"></rect>
        <path d="M9.5 12V36M21 12L11.5 25M14.5 22L21.5 36M22.5 12L26.5 36L30.5 20L34.5 36L38.5 12" fill="none" stroke="#f7e9e4" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round"></path>
      </svg>
      <span class="marka__napis">{t('marka.nazwa')}</span>
    </a>
    <button
      class="menu-przelacznik"
      type="button"
      aria-expanded="false"
      aria-controls="menu-glowne"
      data-otworz={t('interfejs.hamburger')}
      data-zamknij={t('interfejs.zamknij')}
    >
      <svg class="ikona-otworz" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      <svg class="ikona-zamknij" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      <span class="menu-przelacznik__napis">{t('interfejs.hamburger')}</span>
    </button>
    <nav class="menu" id="menu-glowne" aria-label={t('interfejs.menuAria')}>
      <ul>
        {
          pozycje.map((p) => (
            <li>
              <a href={p.href} aria-current={p.biezaca ? (sciezka === p.href ? 'page' : 'true') : undefined}>{p.etykieta}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<noscript>
  <style>
    .menu-przelacznik { display: none; }
    .menu { display: block; }
    .menu ul { display: flex; flex-wrap: wrap; gap: 0 1rem; }
    .menu a { font-size: 1rem; }
  </style>
</noscript>

<script>
  const naglowek = document.getElementById('naglowek') as HTMLElement;
  const przelacznik = naglowek.querySelector<HTMLButtonElement>('.menu-przelacznik')!;
  const napis = przelacznik.querySelector<HTMLElement>('.menu-przelacznik__napis')!;
  const menu = document.getElementById('menu-glowne') as HTMLElement;
  const html = document.documentElement;
  // Tryb panelu rozpoznajemy z CSS (przełącznik widoczny), nie z szerokości okna: jeden próg w jednym miejscu.
  const panelAktywny = () => getComputedStyle(przelacznik).display !== 'none';

  const ustaw = (otwarte: boolean) => {
    przelacznik.setAttribute('aria-expanded', String(otwarte));
    napis.textContent = (otwarte ? przelacznik.dataset.zamknij : przelacznik.dataset.otworz) ?? '';
    naglowek.toggleAttribute('data-otwarte', otwarte);
    html.classList.toggle('menu-otwarte', otwarte);
    document.querySelectorAll<HTMLElement>('main, footer').forEach((el) => (el.inert = otwarte));
  };

  przelacznik.addEventListener('click', () => ustaw(przelacznik.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && przelacznik.getAttribute('aria-expanded') === 'true') {
      ustaw(false);
      przelacznik.focus();
    }
  });
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) ustaw(false);
  });
  window.addEventListener('resize', () => {
    if (!panelAktywny() && przelacznik.getAttribute('aria-expanded') === 'true') ustaw(false);
  });
</script>
