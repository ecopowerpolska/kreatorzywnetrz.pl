---
// Zapowiedź wpisu z naszej strony: tylko tytuł, 2–4 zdania i link „Czytaj dalej na <źródło>” z rel="nofollow"
// (blok polecający; link w treści wpisu zostaje bez rel).
// Zdjęcie z RSS ładuje przeglądarka z serwera źródła (nasze strony); bez zdjęcia karta jest tekstowa.
import { dataIso, dataPoPolsku, type Polecany } from '../lib/wpisy';
import { t, wstaw } from '../lib/tekst';

interface Props {
  wpis: Polecany;
  /** Szablon napisu odnośnika z {zrodlo}; domyślnie interfejs.czytajDalejNa. */
  napis?: string;
}
const { wpis, napis = t('interfejs.czytajDalejNa') } = Astro.props;
const d = wpis.data;
---

<article class="karta karta--zapowiedz">
  {
    d.zdjecie && (
      <div class="karta__zdjecie">
        <img src={d.zdjecie} alt="" width="600" height="400" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
      </div>
    )
  }
  <div class="karta__tekst">
    <p class="karta__meta">
      <span class="karta__zrodlo">{d.zrodlo}</span>{' '}
      <time datetime={dataIso(d.data)}>{dataPoPolsku(d.data)}</time>
    </p>
    <h3 class="karta__tytul">{d.tytul}</h3>
    <p>{d.opis}</p>
    <a class="karta__czytaj" href={d.link} rel="nofollow">{wstaw(napis, { zrodlo: d.zrodlo })}</a>
  </div>
</article>
