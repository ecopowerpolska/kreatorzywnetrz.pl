---
// Zapowiedź wpisu z naszej strony: data ORYGINAŁU z podpisem „opublikowano na {zrodlo}” (decyzja 6), tytuł, opis
// i odnośnik „Czytaj dalej na {zrodlo}” z rel="nofollow" (blok szablonowy). Zdjęcie z RSS ładuje się z serwera źródła.
import { dataIso, dataPoPolsku } from '../lib/wpisy';
import type { Polecany } from '../lib/polecane';
import { t, wstaw } from '../lib/tekst';

interface Props {
  wpis: Polecany;
  poziom?: 2 | 3;
}
const { wpis, poziom = 3 } = Astro.props;
const d = wpis.data;
const Tytul = poziom === 2 ? 'h2' : 'h3';
---

<article class="karta karta--zapowiedz">
  {
    d.zdjecie && (
      <div class="karta__zdjecie odslon">
        <img src={d.zdjecie} alt="" width="600" height="400" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
      </div>
    )
  }
  <div class="karta__tekst">
    <p class="karta__meta">
      <span>
        <time datetime={dataIso(d.data)}>{dataPoPolsku(d.data)}</time>,{' '}
        <span class="karta__zrodlo">{wstaw(t('interfejs.opublikowanoNa'), { zrodlo: d.zrodlo })}</span>
      </span>
    </p>
    <Tytul class="karta__tytul">{d.tytul}</Tytul>
    <p class="karta__opis">{d.opis}</p>
    <a class="karta__czytaj" href={d.link} rel="nofollow">{wstaw(t('interfejs.czytajNaZrodle'), { zrodlo: d.zrodlo })}</a>
  </div>
</article>
