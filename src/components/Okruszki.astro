---
// Okruszki: ostatnia pozycja bez odnośnika (aria-current). Ta sama lista idzie do BreadcrumbList (schemat.ts).
import { t } from '../lib/tekst';

interface Props {
  pozycje: { nazwa: string; adres?: string }[];
}
const { pozycje } = Astro.props;
---

<nav class="okruszki kontener" aria-label={t('interfejs.okruszkiAria')}>
  <ol>
    {
      pozycje.map((p, i) =>
        i === pozycje.length - 1 || !p.adres ? (
          <li><span aria-current="page">{p.nazwa}</span></li>
        ) : (
          <li><a href={p.adres}>{p.nazwa}</a></li>
        ),
      )
    }
  </ol>
</nav>
