---
// Karta wpisu: zdjęcie 3:2 (albo plansza działu, gdy wpis nie ma zdjęcia), linia meta (dział jako odnośnik do działu, data, czas czytania), tytuł, opis.
// Tytuł jest odnośnikiem rozciągniętym na całą kartę; etykieta działu leży nad nim warstwą (z-index) i prowadzi do działu.
import Foto from './Foto.astro';
import { adresWpisu, czasCzytania, dataIso, dataPoPolsku, type Wpis } from '../lib/wpisy';
import { adresDzialu, nazwaDzialu } from '../lib/dzialy';
import { t, wstaw } from '../lib/tekst';

interface Props {
  wpis: Wpis;
  /** Karta główna (najnowszy wpis): większe zdjęcie, tekst obok. */
  glowna?: boolean;
  priorytet?: boolean;
  /** Na stronie działu etykieta działu jest zbędna (dział stoi w H1). */
  bezDzialu?: boolean;
  /** Poziom nagłówka tytułu: 2 na listach bez nagłówka sekcji, 3 pod H2 sekcji (domyślnie), 4 pod H3 bloku działu. */
  poziom?: 2 | 3 | 4;
}
const { wpis, glowna = false, priorytet = false, bezDzialu = false, poziom = 3 } = Astro.props;
const d = wpis.data;
const Tytul = (['h2', 'h3', 'h4'] as const)[poziom - 2];
const minuty = czasCzytania(wpis);
// Plansza wpisu bez zdjęcia: mały napis = dział, duży = pierwszy tag inny niż nazwa działu (np. „Roaming”), inaczej dział
const nazwaD = nazwaDzialu(d.dzial);
const tag = d.tagi.find((x) => x.toLocaleLowerCase('pl') !== nazwaD.toLocaleLowerCase('pl'));
const haslo = tag ? tag.charAt(0).toLocaleUpperCase('pl') + tag.slice(1) : nazwaD;
---

<article class:list={['karta', { 'karta--glowna': glowna }]}>
  {
    d.zdjecie ? (
      <div class="karta__zdjecie">
        <Foto
          nazwa={d.zdjecie}
          alt={d.alt}
          widths={glowna ? [560, 800, 1100, 1400] : [380, 600, 800]}
          sizes={glowna
            ? '(min-width: 56rem) 55vw, calc(100vw - 2.5rem)'
            : '(min-width: 76rem) 24rem, (min-width: 48rem) 45vw, calc(100vw - 2.5rem)'}
          priorytet={priorytet}
        />
      </div>
    ) : (
      // Wpis bez zdjęcia: plansza w kolorze działu z jego nazwą (ozdoba; dział i tytuł są w tekście karty)
      <div class={`karta__plansza plansza--${d.dzial}`} aria-hidden="true">
        <span class="karta__plansza-dzial">{nazwaD}</span>
        <span class="karta__plansza-haslo">{haslo}</span>
      </div>
    )
  }
  <div class="karta__tekst">
    <p class="karta__meta">
      {!bezDzialu && <a class="karta__dzial" href={adresDzialu(d.dzial)}>{nazwaDzialu(d.dzial)}</a>}
      <time datetime={dataIso(d.data)}>{dataPoPolsku(d.data)}</time>
      <span>{wstaw(t('interfejs.minCzytania'), { n: String(minuty) })}</span>
    </p>
    <Tytul class="karta__tytul"><a href={adresWpisu(wpis.id)}>{d.tytul}</a></Tytul>
    <p>{d.opis}</p>
  </div>
</article>
