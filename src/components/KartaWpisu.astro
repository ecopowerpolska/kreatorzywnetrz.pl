---
// Karta wpisu: kadr-łuk 4:5 (albo plansza działu, gdy wpis nie ma zdjęcia), linia meta (dział jako odnośnik, data, czas czytania),
// tytuł, opis. Tytuł jest odnośnikiem rozciągniętym na całą kartę; etykieta działu leży nad nim warstwą i prowadzi do działu.
// Zdjęcie karty odsłania się przy przewijaniu (.odslon), poza kartą z `priorytet` (kandydat na LCP).
import Foto from './Foto.astro';
import { adresWpisu, czasCzytania, dataIso, dataPoPolsku, type Wpis } from '../lib/wpisy';
import { adresDzialu, nazwaDzialu } from '../lib/dzialy';
import { t, wstaw } from '../lib/tekst';

interface Props {
  wpis: Wpis;
  /** Karta główna (najnowszy wpis): większy kadr, tekst obok. */
  glowna?: boolean;
  priorytet?: boolean;
  /** Na stronie działu etykieta działu jest zbędna (dział stoi w H1). */
  bezDzialu?: boolean;
  /** Poziom nagłówka tytułu: 2 na listach bez nagłówka sekcji, 3 pod H2 sekcji (domyślnie). */
  poziom?: 2 | 3 | 4;
}
const { wpis, glowna = false, priorytet = false, bezDzialu = false, poziom = 3 } = Astro.props;
const d = wpis.data;
const Tytul = (['h2', 'h3', 'h4'] as const)[poziom - 2];
const minuty = czasCzytania(wpis);
---

<article class:list={['karta', { 'karta--glowna': glowna }]}>
  {
    d.zdjecie ? (
      <div class:list={['karta__zdjecie', { odslon: !priorytet }]}>
        <Foto
          nazwa={d.zdjecie}
          alt={d.alt}
          widths={glowna ? [480, 720, 960, 1200] : [360, 540, 720]}
          sizes={glowna ? '(min-width: 56rem) 34rem, calc(100vw - 2.5rem)' : '(min-width: 76rem) 23rem, (min-width: 40rem) 45vw, calc(100vw - 2.5rem)'}
          proporcja={4 / 5}
          priorytet={priorytet}
        />
      </div>
    ) : (
      <div class={`karta__plansza plansza--${d.dzial}`} aria-hidden="true" />
    )
  }
  <div class="karta__tekst">
    <p class="karta__meta">
      {!bezDzialu && <a class="karta__dzial" href={adresDzialu(d.dzial)}>{nazwaDzialu(d.dzial)}</a>}
      <time datetime={dataIso(d.data)}>{dataPoPolsku(d.data)}</time>
      <span>{wstaw(t('interfejs.minCzytania'), { liczba: String(minuty) })}</span>
    </p>
    <Tytul class="karta__tytul"><a href={adresWpisu(wpis.id)}>{d.tytul}</a></Tytul>
    <p class="karta__opis">{d.opis}</p>
  </div>
</article>
