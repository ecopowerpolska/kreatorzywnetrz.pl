---
// Strona działu /<slug>/: okruszki, H1 i wstęp z teksty.json `dzialy.<slug>`, wpisy działu od najnowszego (pierwszy jako
// karta wiodąca), na dole pozostałe działy. Okładka działu dzial-<slug>.webp w kadrze-łuku 3:2 obok nagłówka (na telefonie pod nim)
// jest kandydatem na LCP, więc karta wiodąca nie dostaje już priorytetu. Dział bez opublikowanych wpisów: noindex (hak sitemapy wycina go z sitemap.xml).
import Bazowy from '../layouts/Bazowy.astro';
import Okruszki from '../components/Okruszki.astro';
import KartaWpisu from '../components/KartaWpisu.astro';
import Foto from '../components/Foto.astro';
import { t } from '../lib/tekst';
import { DZIALY, adresDzialu, nazwaDzialu, type Dzial } from '../lib/dzialy';
import { adresWpisu, zDzialu } from '../lib/wpisy';
import { adresBezwzgledny, okruszki } from '../lib/schemat';

export function getStaticPaths() {
  return DZIALY.map((dzial) => ({ params: { dzial } }));
}

const dzial = Astro.params.dzial as Dzial;
const wpisy = await zDzialu(dzial);
const [wiodacy, ...reszta] = wpisy;
const nazwa = nazwaDzialu(dzial);
const inne = DZIALY.filter((d) => d !== dzial);

const pozycje = [
  { nazwa: t('interfejs.okruszkiStart'), adres: '/' },
  { nazwa, adres: adresDzialu(dzial) },
];
const schemat = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${adresBezwzgledny(adresDzialu(dzial))}#dzial`,
    name: nazwa,
    description: t(`dzialy.${dzial}.metaOpis`),
    url: adresBezwzgledny(adresDzialu(dzial)),
    inLanguage: 'pl-PL',
    isPartOf: { '@id': `${adresBezwzgledny('/')}#strona` },
    ...(wpisy.length > 0 && {
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: wpisy.map((w, i) => ({ '@type': 'ListItem', position: i + 1, url: adresBezwzgledny(adresWpisu(w.id)) })),
      },
    }),
  },
  okruszki(pozycje),
];
---

<Bazowy tytul={`${nazwa} | ${t('marka.nazwa')}`} opis={t(`dzialy.${dzial}.metaOpis`)} {schemat} bezIndeksu={wpisy.length === 0}>
  <Okruszki pozycje={pozycje} />
  <div class="kontener podstrona-glowa podstrona-glowa--z-kadrem">
    <div>
      <h1>{nazwa}</h1>
      <p class="podstrona-glowa__wstep">{t(`dzialy.${dzial}.opis`)}</p>
    </div>
    <div class="kadr-luk">
      <Foto nazwa={`dzial-${dzial}.webp`} widths={[400, 640, 880, 1200]} sizes="(min-width: 56rem) 30rem, calc(100vw - 2.5rem)" priorytet />
    </div>
  </div>
  {
    wiodacy && (
      <section class="kontener sekcja sekcja--bez-gory" aria-label={nazwa}>
        <KartaWpisu wpis={wiodacy} glowna bezDzialu poziom={2} />
        {reszta.length > 0 && (
          <ul class="karty">
            {reszta.map((w) => (
              <li>
                <KartaWpisu wpis={w} bezDzialu poziom={2} />
              </li>
            ))}
          </ul>
        )}
      </section>
    )
  }
  <nav class="kontener inne-dzialy" aria-labelledby="inne-dzialy">
    <h2 id="inne-dzialy">{t('glowna.dzialyNaglowek')}</h2>
    <ul>
      {
        inne.map((d) => (
          <li>
            <a class="przycisk przycisk--obrys" href={adresDzialu(d)}>
              {nazwaDzialu(d)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</Bazowy>
