---
// Strona działu /<slug>/ (projekt-wnetrza, remont, meble-na-wymiar, materialy): okruszki, H1 i wstęp z teksty.json `dzialy.<slug>`,
// wpisy działu od najnowszego (pierwszy jako karta wiodąca), na dole pozostałe działy.
// Dział bez opublikowanych wpisów: komunikat i noindex (hak sitemapy w astro.config.mjs wycina go z sitemap.xml).
// Trasy statyczne (o-nas, polecamy, polityka-prywatnosci, blog/…) mają pierwszeństwo, a slugi działów z nimi nie kolidują.
import Bazowy from '../layouts/Bazowy.astro';
import Okruszki from '../components/Okruszki.astro';
import KartaWpisu from '../components/KartaWpisu.astro';
import { t } from '../lib/tekst';
import { DZIALY, adresDzialu, nazwaDzialu, type Dzial } from '../lib/dzialy';
import { adresWpisu, zDzialu } from '../lib/wpisy';
import { adresBezwzgledny, okruszki } from '../lib/schemat';

export function getStaticPaths() {
  return DZIALY.map((dzial) => ({ params: { dzial } }));
}

const dzial = Astro.params.dzial as Dzial;
const wpisy = await zDzialu(dzial);
const [wiodacy, ...reszta] = wpisy;
const nazwa = nazwaDzialu(dzial);
const inne = DZIALY.filter((d) => d !== dzial);

const pozycje = [
  { nazwa: t('interfejs.okruszki_glowna'), adres: '/' },
  { nazwa, adres: adresDzialu(dzial) },
];
const schemat = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${adresBezwzgledny(adresDzialu(dzial))}#dzial`,
    name: nazwa,
    description: t(`dzialy.${dzial}.opisMeta`),
    url: adresBezwzgledny(adresDzialu(dzial)),
    inLanguage: 'pl-PL',
    isPartOf: { '@id': `${adresBezwzgledny('/')}#strona` },
    ...(wpisy.length > 0 && {
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: wpisy.map((w, i) => ({ '@type': 'ListItem', position: i + 1, url: adresBezwzgledny(adresWpisu(w.id)) })),
      },
    }),
  },
  okruszki(pozycje),
];
---

<Bazowy tytul={t(`dzialy.${dzial}.tytulKarty`)} opis={t(`dzialy.${dzial}.opisMeta`)} {schemat} bezIndeksu={wpisy.length === 0}>
  <Okruszki pozycje={pozycje} />
  <div class="kontener podstrona-glowa">
    <h1>{t(`dzialy.${dzial}.h1`)}</h1>
    <p class="podstrona-glowa__wstep">{t(`dzialy.${dzial}.wstep`)}</p>
  </div>
  <section class="kontener sekcja sekcja--bez-gory" aria-label={nazwa}>
    {
      wiodacy ? (
        <>
          <KartaWpisu wpis={wiodacy} glowna priorytet bezDzialu poziom={2} />
          {reszta.length > 0 && (
            <ul class="karty">
              {reszta.map((w) => <li><KartaWpisu wpis={w} bezDzialu poziom={2} /></li>)}
            </ul>
          )}
        </>
      ) : (
        <p class="pusto">{t('interfejs.brakWpisow')}</p>
      )
    }
  </section>
  <nav class="kontener inne-dzialy" aria-labelledby="inne-dzialy">
    <h2 id="inne-dzialy">{t('glowna.naglowekDzialy')}</h2>
    <ul>
      {inne.map((d) => <li><a href={adresDzialu(d)}>{nazwaDzialu(d)}</a></li>)}
    </ul>
  </nav>
</Bazowy>
