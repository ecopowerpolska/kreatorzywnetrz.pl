---
import Bazowy from '../layouts/Bazowy.astro';
import { t } from '../lib/tekst';
---

<Bazowy tytul={`${t('e404.tytul')} | ${t('marka.nazwa')}`} opis={t('e404.opis')} bezIndeksu>
  <div class="kontener komunikat">
    <p class="strona-404__liczba" aria-hidden="true">404</p>
    <h1>{t('e404.tytul')}</h1>
    <p>{t('e404.tekst')}</p>
    <a class="przycisk" href="/">{t('e404.powrot')}</a>
  </div>
</Bazowy>
