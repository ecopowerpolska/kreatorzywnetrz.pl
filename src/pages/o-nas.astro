---
// /o-nas/: kim jest redakcja (teksty.json `o-nas.*`), podpis „Redakcja Kreatorów Wnętrz”. Bez danych wydawcy.
import Bazowy from '../layouts/Bazowy.astro';
import Okruszki from '../components/Okruszki.astro';
import { t, lista, kawalki } from '../lib/tekst';
import { okruszki } from '../lib/schemat';

const pozycje = [
  { nazwa: t('interfejs.okruszkiStart'), adres: '/' },
  { nazwa: t('o-nas.tytul'), adres: '/o-nas/' },
];
const schemat = [okruszki(pozycje)];
---

<Bazowy tytul={`${t('o-nas.tytul')} | ${t('marka.nazwa')}`} opis={t('o-nas.opis')} {schemat}>
  <Okruszki pozycje={pozycje} />
  <div class="kontener podstrona-glowa">
    <h1>{t('o-nas.tytul')}</h1>
  </div>
  <div class="kontener">
    <div class="proza">
      {lista('o-nas.akapity').map((a) => <p>{kawalki(a).map((k) => (k.adres ? <a href={k.adres}>{k.tekst}</a> : k.tekst))}</p>)}
      <p class="proza__podpis">{t('o-nas.podpis')}</p>
    </div>
  </div>
</Bazowy>
