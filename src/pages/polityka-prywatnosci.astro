---
// Polityka prywatności: cała treść z teksty.json → polityka.tytul i polityka.sekcje[{naglowek, akapity[]}]
// (administrator danych wpisany wprost w tekst sekcji — jedyne miejsce strony z danymi wydawcy). [kotwica](/trasa/) = odnośnik.
import Bazowy from '../layouts/Bazowy.astro';
import Okruszki from '../components/Okruszki.astro';
import { t, obiekty, pole, kawalki } from '../lib/tekst';
import { okruszki } from '../lib/schemat';

const sekcje = obiekty('polityka.sekcje').map((s, i) => ({
  naglowek: pole(s, 'naglowek', `polityka.sekcje.${i}`),
  akapity: Array.isArray(s.akapity) ? s.akapity.filter((a): a is string => typeof a === 'string' && a.trim() !== '') : [],
}));

const pozycje = [
  { nazwa: t('interfejs.okruszkiStart'), adres: '/' },
  { nazwa: t('polityka.tytul'), adres: '/polityka-prywatnosci/' },
];
const schemat = [okruszki(pozycje)];
---

<Bazowy tytul={`${t('polityka.tytul')} | ${t('marka.nazwa')}`} opis={t('polityka.opis')} {schemat}>
  <Okruszki pozycje={pozycje} />
  <div class="kontener podstrona-glowa">
    <h1>{t('polityka.tytul')}</h1>
  </div>
  <div class="kontener">
    <div class="proza">
      {
        sekcje.map((s) => (
          <>
            <h2>{s.naglowek}</h2>
            {s.akapity.map((a) => (
              <p>{kawalki(a).map((k) => (k.adres ? <a href={k.adres}>{k.tekst}</a> : k.tekst))}</p>
            ))}
          </>
        ))
      }
    </div>
  </div>
</Bazowy>
