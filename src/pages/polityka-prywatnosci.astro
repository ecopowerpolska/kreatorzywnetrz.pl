---
// Polityka prywatności: cała treść z teksty.json → polityka.tytul i polityka.sekcje[{naglowek, akapity[]}]
// (administrator danych wpisany wprost w tekst sekcji). W tekście: [kotwica](/trasa/) = odnośnik.
import Bazowy from '../layouts/Bazowy.astro';
import Okruszki from '../components/Okruszki.astro';
import { t, pobierz, kawalki } from '../lib/tekst';
import { okruszki } from '../lib/schemat';

const naTekst = (v: unknown) => (typeof v === 'string' ? v.trim() : '');
const teksty = (v: unknown) => (Array.isArray(v) ? v.map(naTekst).filter(Boolean) : []);
const sekcje = (Array.isArray(pobierz('polityka.sekcje')) ? (pobierz('polityka.sekcje') as Record<string, unknown>[]) : [])
  .map((s) => ({ naglowek: naTekst(s?.naglowek), akapity: teksty(s?.akapity) }))
  .filter((s) => s.naglowek);

const pozycje = [
  { nazwa: t('interfejs.okruszkiStart'), adres: '/' },
  { nazwa: t('polityka.tytul'), adres: '/polityka-prywatnosci/' },
];
const schemat = [okruszki(pozycje)];
---

<Bazowy tytul={`${t('polityka.tytul')} | ${t('marka.nazwa')}`} opis={t('polityka.tytul')} {schemat}>
  <Okruszki pozycje={pozycje} />
  <div class="kontener podstrona-glowa">
    <h1>{t('polityka.tytul')}</h1>
  </div>
  <div class="kontener strona-tekst">
    <div class="strona-tekst__kolumna proza">
      {
        sekcje.map((s) => (
          <>
            <h2>{s.naglowek}</h2>
            {s.akapity.map((a) => (
              <p>{kawalki(a).map((k) => (k.adres ? <a href={k.adres}>{k.tekst}</a> : k.tekst))}</p>
            ))}
          </>
        ))
      }
    </div>
  </div>
</Bazowy>
