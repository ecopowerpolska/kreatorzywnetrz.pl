---
// /kontakt/: jasna góra (tytuł, wstęp, zdjęcie kontakt.webp w ramce; w finale zdjęcia nie ma), ostatnia sekcja = finał „Zmierzch” z guzikiem, formularz w <dialog> pod finałem.
import Bazowy from '../layouts/Bazowy.astro';
import FinalKontaktu from '../components/FinalKontaktu.astro';
import Foto from '../components/Foto.astro';
import FormularzKontaktu from '../components/FormularzKontaktu.astro';
import { t } from '../lib/tekst';
import { adresBezwzgledny } from '../lib/schemat';

const schemat = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: t('kontakt.tytul'),
    description: t('kontakt.opis'),
    url: adresBezwzgledny('/kontakt/'),
    inLanguage: 'pl-PL',
    isPartOf: { '@id': `${adresBezwzgledny('/')}#strona` },
  },
];
---

<Bazowy tytul={`${t('kontakt.tytul')} | ${t('marka.nazwa')}`} opis={t('kontakt.opis')} {schemat}>
  <section class="kontener kontakt-gora" aria-labelledby="kontakt-tytul">
    <div>
      <h1 id="kontakt-tytul">{t('kontakt.tytul')}</h1>
      <p>{t('kontakt.wstep')}</p>
    </div>
    <div class="kontakt-gora__zdjecie ramka">
      <Foto nazwa="kontakt.webp" widths={[400, 640, 880, 1200]} sizes="(min-width: 76rem) 35rem, (min-width: 56rem) 46vw, calc(100vw - 2.5rem)" priorytet />
    </div>
  </section>
  <FinalKontaktu />
  <FormularzKontaktu />
</Bazowy>
