---
// Wpis: licznik czytania (pasek), okruszki Strona główna › Dział › Tytuł, etykieta działu, H1, linia meta (data, podpis redakcji
// z odnośnikiem do /o-nas/, czas czytania), zdjęcie (LCP, bez odsłaniania), treść z przyklejonym spisem treści,
// a POZA </article>: „Więcej z działu” i poprzedni/następny (bramka linków czyta treść tylko z <div class="tresc">).
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Bazowy from '../../layouts/Bazowy.astro';
import Okruszki from '../../components/Okruszki.astro';
import Foto from '../../components/Foto.astro';
import KartaWpisu from '../../components/KartaWpisu.astro';
import SpisTresci from '../../components/SpisTresci.astro';
import LicznikCzytania from '../../components/LicznikCzytania.astro';
import { t, wstaw } from '../../lib/tekst';
import { adresWpisu, czasCzytania, dataIso, dataPoPolsku, opublikowane, rozdzialy, wiecejZDzialu } from '../../lib/wpisy';
import { adresDzialu, nazwaDzialu } from '../../lib/dzialy';
import { zdjecie, ZDJECIE_GLOWNE } from '../../lib/zdjecia';
import { adresBezwzgledny, okruszki as schematOkruszkow } from '../../lib/schemat';

export async function getStaticPaths() {
  const wpisy = await opublikowane(); // od najnowszego
  return wpisy.map((wpis, i) => ({
    params: { slug: wpis.id },
    props: {
      wpis,
      nastepny: i > 0 ? wpisy[i - 1] : undefined, // nowszy
      poprzedni: i < wpisy.length - 1 ? wpisy[i + 1] : undefined, // starszy
      wiecej: wiecejZDzialu(wpis, wpisy),
    },
  }));
}

const { wpis, poprzedni, nastepny, wiecej } = Astro.props;
const d = wpis.data;
const { Content, headings } = await render(wpis);
const spis = rozdzialy(headings);

const kadrOg = await getImage({ src: zdjecie(d.zdjecie ?? ZDJECIE_GLOWNE), width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 });
const obrazOg = adresBezwzgledny(kadrOg.src);
const adres = adresBezwzgledny(adresWpisu(wpis.id));
const nazwaD = nazwaDzialu(d.dzial);
const adresD = adresDzialu(d.dzial);
const minuty = czasCzytania(wpis);
const podpis = t('o-nas.podpis');
// <title> z marką tylko do 65 znaków; dłuższy tytuł idzie sam (marka zostaje w og:site_name).
const tytulZMarka = `${d.tytul} | ${t('marka.nazwa')}`;
const tytulStrony = tytulZMarka.length <= 65 ? tytulZMarka : d.tytul;

const pozycje = [
  { nazwa: t('interfejs.okruszkiStart'), adres: '/' },
  { nazwa: nazwaD, adres: adresD },
  { nazwa: d.tytul, adres: adresWpisu(wpis.id) },
];
const schemat = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${adres}#wpis`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': adres },
    headline: d.tytul,
    description: d.opis,
    image: d.zdjecie ? [obrazOg] : undefined,
    datePublished: dataIso(d.data),
    dateModified: dataIso(d.zmieniono ?? d.data),
    inLanguage: 'pl-PL',
    articleSection: nazwaD,
    keywords: d.tagi.join(', ') || undefined,
    author: { '@type': 'Organization', name: podpis, url: adresBezwzgledny('/o-nas/') },
    publisher: { '@id': `${adresBezwzgledny('/')}#organizacja`, '@type': 'Organization', name: t('marka.nazwa'), url: adresBezwzgledny('/') },
  },
  schematOkruszkow(pozycje),
];
---

<Bazowy tytul={tytulStrony} opis={d.opis} typOg="article" {obrazOg} obrazOgAlt={d.alt ?? t('marka.nazwa')} {schemat} podswietl={adresD}>
  <LicznikCzytania />
  <Okruszki pozycje={pozycje} />
  <article class:list={['wpis', { 'wpis--bez-zdjecia': !d.zdjecie }]}>
    <header class="wpis__glowa kontener">
      <p class="wpis__dzial"><a href={adresD}>{nazwaD}</a></p>
      <h1>{d.tytul}</h1>
      <p class="wpis__meta">
        <time datetime={dataIso(d.data)}>{dataPoPolsku(d.data)}</time>
        <a class="wpis__podpis" href="/o-nas/">{podpis}</a>
        <span>{wstaw(t('interfejs.minCzytania'), { liczba: String(minuty) })}</span>
      </p>
    </header>
    {
      d.zdjecie && (
        <figure class="wpis__zdjecie">
          <div class="ramka">
            <Foto nazwa={d.zdjecie} alt={d.alt} widths={[640, 960, 1280, 1600, 2000]} sizes="(min-width: 76rem) 71rem, calc(100vw - 3.5rem)" priorytet />
          </div>
        </figure>
      )
    }
    <div class="kontener wpis__uklad">
      <SpisTresci naglowki={spis} />
      <div class="tresc">
        <Content />
      </div>
    </div>
  </article>

  {
    wiecej.length > 0 && (
      <section class="sekcja sekcja--powierzchnia" aria-labelledby="wiecej-z-dzialu">
        <div class="kontener">
          <div class="sekcja__glowa">
            <h2 id="wiecej-z-dzialu">{wstaw(t('interfejs.wiecejZDzialu'), { dzial: nazwaD })}</h2>
          </div>
          <ul class="karty">
            {wiecej.map((w) => (
              <li>
                <KartaWpisu wpis={w} bezDzialu={w.data.dzial === d.dzial} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    (poprzedni || nastepny) && (
      <div class="kontener">
        <nav class="sasiedzi" aria-label={`${t('interfejs.poprzedni')}, ${t('interfejs.nastepny')}`}>
          {poprzedni && (
            <a class="sasiedzi__poprzedni" href={adresWpisu(poprzedni.id)} rel="prev">
              <span class="sasiedzi__etykieta">{t('interfejs.poprzedni')}</span>
              <span class="sasiedzi__tytul">{poprzedni.data.tytul}</span>
            </a>
          )}
          {nastepny && (
            <a class="sasiedzi__nastepny" href={adresWpisu(nastepny.id)} rel="next">
              <span class="sasiedzi__etykieta">{t('interfejs.nastepny')}</span>
              <span class="sasiedzi__tytul">{nastepny.data.tytul}</span>
            </a>
          )}
        </nav>
      </div>
    )
  }
</Bazowy>
