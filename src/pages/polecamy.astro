---
// /polecamy/: trzy firmy z teksty.json `polecamy.firmy[{nazwa, zdanie, fakty[], url, przycisk}]`, przycisk z rel="nofollow"
// (blok szablonowy), zdjęcie karty polecamy-<nazwa-firmy>.webp w kadrze-łuku 3:2 (pierwsze = kandydat na LCP), pod nimi zapowiedzi ich wpisów z RSS (najwyżej 3 z firmy, 12 razem). Bez logo, ocen i cen.
import Bazowy from '../layouts/Bazowy.astro';
import Okruszki from '../components/Okruszki.astro';
import KartaPolecana from '../components/KartaPolecana.astro';
import Foto from '../components/Foto.astro';
import { t, tMozePusty, obiekty, pole } from '../lib/tekst';
import { wszystkiePolecane, polecaneRozne, NA_ZRODLO_POLECAMY } from '../lib/polecane';
import { adresBezwzgledny, okruszki } from '../lib/schemat';

const firmy = obiekty('polecamy.firmy').map((f, i) => {
  const sciezka = `polecamy.firmy.${i}`;
  const url = pole(f, 'url', sciezka);
  if (!/^https:\/\//.test(url)) throw new Error(`teksty.json: ${sciezka}.url musi zaczynać się od https:// („${url}”)`);
  const fakty = Array.isArray(f.fakty) ? f.fakty.filter((x): x is string => typeof x === 'string' && x.trim() !== '') : [];
  const nazwa = pole(f, 'nazwa', sciezka);
  const zdjecie = `polecamy-${nazwa.toLowerCase().trim().replace(/\s+/g, '-')}.webp`;
  return { nazwa, zdjecie, zdanie: pole(f, 'zdanie', sciezka), przycisk: pole(f, 'przycisk', sciezka), url, fakty };
});
const wstep = tMozePusty('polecamy.wstep');
const zapowiedzi = polecaneRozne(await wszystkiePolecane(), NA_ZRODLO_POLECAMY).slice(0, 12);

const pozycje = [
  { nazwa: t('interfejs.okruszkiStart'), adres: '/' },
  { nazwa: t('polecamy.tytul'), adres: '/polecamy/' },
];
const schemat = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${adresBezwzgledny('/polecamy/')}#polecamy`,
    name: t('polecamy.tytul'),
    description: t('polecamy.opis'),
    url: adresBezwzgledny('/polecamy/'),
    inLanguage: 'pl-PL',
    isPartOf: { '@id': `${adresBezwzgledny('/')}#strona` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: firmy.map((f, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Organization', name: f.nazwa, url: f.url } })),
    },
  },
  okruszki(pozycje),
];
---

<Bazowy tytul={`${t('polecamy.tytul')} | ${t('marka.nazwa')}`} opis={t('polecamy.opis')} {schemat}>
  <Okruszki pozycje={pozycje} />
  <div class="kontener podstrona-glowa">
    <h1>{t('polecamy.tytul')}</h1>
    {wstep !== '' && <p class="podstrona-glowa__wstep">{wstep}</p>}
  </div>

  <div class="kontener">
    <ul class="firmy">
      {
        firmy.map((f, i) => (
          <li class="firma">
            <div class:list={['kadr-luk', 'firma__kadr', { odslon: i > 0 }]}>
              <Foto nazwa={f.zdjecie} widths={[360, 540, 720, 960]} sizes="(min-width: 76rem) 21rem, (min-width: 64rem) 28vw, calc(100vw - 5.5rem)" priorytet={i === 0} />
            </div>
            <h2>{f.nazwa}</h2>
            <p class="firma__zdanie">{f.zdanie}</p>
            {f.fakty.length > 0 && (
              <ul>
                {f.fakty.map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
            )}
            <a class="przycisk przycisk--obrys" href={f.url} rel="nofollow">
              {f.przycisk}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  {
    zapowiedzi.length > 0 && (
      <section class="sekcja" aria-labelledby="zapowiedzi">
        <div class="kontener">
          <div class="sekcja__glowa">
            <h2 id="zapowiedzi">{t('polecamy.zapowiedziNaglowek')}</h2>
          </div>
          <ul class="karty">
            {zapowiedzi.map((w) => (
              <li>
                <KartaPolecana wpis={w} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Bazowy>
